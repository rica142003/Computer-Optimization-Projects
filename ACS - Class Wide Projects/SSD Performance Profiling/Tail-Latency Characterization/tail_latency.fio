[global]
filename=/dev/sda              # ⚠️ destructive: raw block device
direct=1
ioengine=libaio
bs=4k
rw=randread
numjobs=1
time_based=1
runtime=60s
ramp_time=5s
group_reporting=1

# Force detailed percentiles
lat_percentiles=1
percentile_list=50:95:99:99.9

# Data pattern: incompressible
randrepeat=0
refill_buffers=1
norandommap=1[global]
