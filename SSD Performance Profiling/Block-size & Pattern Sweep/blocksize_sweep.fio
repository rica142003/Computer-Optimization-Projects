# file: blocksize_sweep.fio
[global]
filename=/dev/sda         # raw flash drive (unmounted)
direct=1                  # bypass page cache
ioengine=libaio
iodepth=1                 # keep QD=1 (latency focused)
numjobs=1
time_based=1
runtime=20s
group_reporting=1
lat_percentiles=1
percentile_list=50:95:99

# Block sizes to sweep (pattern fixed)
[randread_4k]
rw=randread
bs=4k

stonewall

[randread_16k]
rw=randread
bs=16k

stonewall

[randread_32k]
rw=randread
bs=32k

stonewall

[randread_64k]
rw=randread
bs=64k

stonewall

[randread_128k]
rw=randread
bs=128k

stonewall

[randread_256k]
rw=randread
bs=256k
