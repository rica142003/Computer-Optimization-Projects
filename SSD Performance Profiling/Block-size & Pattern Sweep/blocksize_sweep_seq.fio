[global]
filename=/dev/sda           # <-- your raw flash device
direct=1
ioengine=libaio
iodepth=1
numjobs=1
time_based=1
runtime=20s
group_reporting=1
lat_percentiles=1
percentile_list=50:95:99

[seqread_4k]
rw=read
bs=4k
stonewall

[seqread_16k]
rw=read
bs=16k
stonewall

[seqread_32k]
rw=read
bs=32k
stonewall

[seqread_64k]
rw=read
bs=64k
stonewall

[seqread_128k]
rw=read
bs=128k
stonewall

[seqread_256k]
rw=read
bs=256k
# Optional larger sizes (uncomment if you want)
# stonewall
# [seqread_512k]
# rw=read
# bs=512k
# stonewall
# [seqread_1m]
# rw=read
# bs=1m
