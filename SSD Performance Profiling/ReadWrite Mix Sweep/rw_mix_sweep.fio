[global]
filename=/dev/sda
direct=1
ioengine=libaio
iodepth=1
numjobs=1
time_based=1
runtime=30s
group_reporting=1
lat_percentiles=1
percentile_list=50:95:99
bs=4k

[rwmix_100R]
rw=randread
stonewall
new_group[global]
filename=/dev/sda
direct=1
ioengine=libaio
iodepth=1
numjobs=1
time_based=1
runtime=30s
group_reporting=1
lat_percentiles=1
percentile_list=50:95:99
bs=4k

[rwmix_100R]
rw=randread
stonewall
new_group

[rwmix_100W]
rw=randwrite
stonewall
new_group

[rwmix_70R30W]
rw=randrw
rwmixread=70
stonewall
new_group

[rwmix_50R50W]
rw=randrw
rwmixread=50
stonewall
new_group


[rwmix_100W]
rw=randwrite
stonewall
new_group

[rwmix_70R30W]
rw=randrw
rwmixread=70
stonewall
new_group

[rwmix_50R50W]
rw=randrw
rwmixread=50
stonewall
new_group
